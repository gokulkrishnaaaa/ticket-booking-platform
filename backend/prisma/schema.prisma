// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  THEATER_CHAIN
  CUSTOMER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  theaterChain TheaterChain?
}

model TheaterChain {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String   @unique
  phoneNumber String
  address     String
  logoUrl     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  theaters Theater[]
}

model Theater {
  id             String   @id @default(uuid())
  theaterChainId String
  name           String
  phoneNumber    String
  isActive       Boolean  @default(true)
  street         String
  city           String
  state          String
  postalCode     String
  country        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theaterChain TheaterChain @relation(fields: [theaterChainId], references: [id], onDelete: Restrict)
  screens      Screen[]

  @@index([theaterChainId])
}

enum ScreenType {
  STANDARD
  IMAX
  DX4
  DOLBY
}

model Screen {
  id         String     @id @default(uuid())
  theaterId  String
  name       String
  screenType ScreenType @default(STANDARD)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  theater Theater @relation(fields: [theaterId], references: [id], onDelete: Restrict)
  seats   Seat[]

  @@unique([theaterId, name])
  @@index([theaterId])
}

enum SeatType {
    REGULAR
    PREMIUM
    RECLINER
}

model Seat {
  id        String   @id @default(uuid())
  screenId  String
  row       String
  number    Int
  seatType  SeatType  @default(REGULAR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screen Screen @relation(fields: [screenId], references: [id], onDelete: Restrict)

  @@unique([screenId, row, number])
  @@index([screenId])
}
