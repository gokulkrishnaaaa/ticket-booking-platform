// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  THEATER_CHAIN
  CUSTOMER
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  theaterChain TheaterChain?
  bookings     Booking[]
}

model TheaterChain {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String   @unique
  phoneNumber String
  address     String
  logoUrl     String?
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  theaters Theater[]
}

model Theater {
  id             String   @id @default(uuid())
  theaterChainId String
  name           String
  phoneNumber    String
  isActive       Boolean  @default(true)
  street         String
  city           String
  state          String
  postalCode     String
  country        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  theaterChain TheaterChain @relation(fields: [theaterChainId], references: [id], onDelete: Restrict)
  screens      Screen[]

  @@index([theaterChainId])
}

enum ScreenType {
  STANDARD
  IMAX
  DX4
  DOLBY
}

model Screen {
  id         String     @id @default(uuid())
  theaterId  String
  name       String
  screenType ScreenType @default(STANDARD)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  theater Theater @relation(fields: [theaterId], references: [id], onDelete: Restrict)
  seats   Seat[]
  shows   Show[]

  @@unique([theaterId, name])
  @@index([theaterId])
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

model Seat {
  id        String   @id @default(uuid())
  screenId  String
  row       String
  number    Int
  seatType  SeatType @default(REGULAR)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  screen    Screen     @relation(fields: [screenId], references: [id], onDelete: Restrict)
  showSeats ShowSeat[]

  @@unique([screenId, row, number])
  @@index([screenId])
}

model Movie {
  id          String   @id @default(uuid())
  title       String
  description String
  languages   String[]
  duration    Int
  genres      String[]
  posterUrl   String?
  releaseDate DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shows Show[]

  @@index([title])
}

model Show {
  id        String   @id @default(uuid())
  movieId   String
  screenId  String
  language  String
  startTime DateTime
  endTime   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen    Screen     @relation(fields: [screenId], references: [id], onDelete: Restrict)
  showSeats ShowSeat[]
  bookings  Booking[]

  @@index([movieId])
  @@index([screenId, startTime])
}

enum ShowSeatStatus {
  AVAILABLE
  RESERVED
  BOOKED
  BLOCKED
}

model ShowSeat {
  id            String         @id @default(uuid())
  showId        String
  seatId        String
  status        ShowSeatStatus @default(AVAILABLE)
  price         Decimal
  reservedUntil DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  show         Show          @relation(fields: [showId], references: [id], onDelete: Restrict)
  seat         Seat          @relation(fields: [seatId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]
  ticket       Ticket?

  @@unique([showId, seatId])
  @@index([showId])
  @@index([seatId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  showId           String
  status           BookingStatus @default(PENDING)
  totalAmount      Decimal
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt()

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  show         Show          @relation(fields: [showId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]
  payments     Payment[]
  tickets      Ticket[]

  @@index([userId])
  @@index([showId])
}

model BookingSeat {
  bookingId  String
  showSeatId String

  booking  Booking  @relation(fields: [bookingId], references: [id])
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id])

  @@id([bookingId, showSeatId])
  @@index([showSeatId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  WALLET
}

enum PaymentGateway {
  RAZORPAY
}

model Payment {
  id            String         @id @default(uuid())
  bookingId     String
  transactionId String?        @unique
  gateway       PaymentGateway
  paymentMethod PaymentMethod
  amount        Decimal
  status        PaymentStatus  @default(PENDING)
  failureReason String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique
  bookingId    String
  showSeatId   String       @unique
  status       TicketStatus @default(ISSUED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  showSeat ShowSeat @relation(fields: [showSeatId], references: [id], onDelete: Restrict)

  @@index([bookingId])
}
